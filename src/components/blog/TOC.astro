---
import { generateToc } from "@/utils/generateToc";
import type { MarkdownHeading } from "astro";
import TOCHeading from "./TOCHeading.astro";
import { Icon } from "astro-icon/components";

interface Props {
	headings: MarkdownHeading[];
}

const { headings } = Astro.props;

const toc = generateToc(headings);
---

<div class="sticky top-20 rounded-t-lg">
	<div class="sticky top-20 bg-bgColor rounded-t-lg">
		<div class="sticky top-20 flex pt-4 ps-8 pb-2 items-end title rounded-t-lg bg-color-75 pe-4 gap-x-1 border-t border-l border-r border-special-light">
			<!--
			<Icon aria-hidden="true" class="flex-shrink-0 h-8 w-6 py-1" focusable="false" name="solar:clipboard-list-line-duotone" />
			-->
			<h4 class="title">Table of Contents</h4>
			<button
				id="close-toc"
				class="absolute top-4 right-4 h-8 w-8 flex items-center justify-center rounded-lg bg-accent-base/5 text-accent-base hover:bg-accent-base/10"
				aria-label="Close TOC"
			>
				<Icon aria-hidden="true" class="h-6 w-6" focusable="false" name="hugeicons:cancel-01" />
			</button>
			
		</div>
	</div>
	<div class="bg-bgColor rounded-b-lg">
		<div class="relative rounded-b-lg pb-6 bg-color-75 border-b border-l border-r border-special-light">
			<div
				id="toc-progress-track"
				aria-hidden="true"
				class="absolute inset-y-4 left-4 w-[2px] rounded-full bg-special-light"
			>
				<div
					id="toc-progress-fill"
					class="absolute inset-x-0 top-0 h-0 rounded-full bg-accent-base"
				></div>
			</div>
			<div class="max-h-[calc(100vh-11rem)] h-auto overflow-y-auto overflow-hidden px-8">
				<ul class="text-sm font-medium text-textColor">
					{toc.map((heading) => <TOCHeading heading={heading} />)}
				</ul>
			</div>
		</div>
	</div>
</div>

<script>
	const tocPanel = document.getElementById("toc-panel");
	const progressFill = document.getElementById("toc-progress-fill");

	if (tocPanel && progressFill) {
		const ACTIVE_OFFSET = 96;

		const items: Array<{ link: HTMLAnchorElement; target: HTMLElement }> = Array.from(
			tocPanel.querySelectorAll('a[href^="#"]'),
		)
			.map((link) => {
				const id = link.getAttribute("href")?.slice(1) ?? "";
				const target = document.getElementById(id);
				return target ? { link: link as HTMLAnchorElement, target } : null;
			})
			.filter(
				(item): item is { link: HTMLAnchorElement; target: HTMLElement } => item !== null,
			)
			.sort((a, b) =>
				a.target.compareDocumentPosition(b.target) & Node.DOCUMENT_POSITION_FOLLOWING ? -1 : 1,
			);

		let activeLink: HTMLAnchorElement | null = null;

		const update = () => {
			const scrollY = window.scrollY;
			const readingLine = scrollY + ACTIVE_OFFSET;

			let firstTop = Infinity;
			let lastBottom = -Infinity;
			let nextActive: HTMLAnchorElement | null = null;

			for (let i = 0; i < items.length; i++) {
				const item = items[i];
				if (!item) continue;
				const top = item.target.getBoundingClientRect().top + scrollY;
				const bottom = item.target.getBoundingClientRect().bottom + scrollY;
				if (top < firstTop) firstTop = top;
				if (bottom > lastBottom) lastBottom = bottom;
				if (top <= readingLine) nextActive = item.link;
			}

			if (nextActive !== activeLink) {
				activeLink?.removeAttribute("data-active");
				activeLink = nextActive;
				activeLink?.setAttribute("data-active", "true");
			}

			if (firstTop !== Infinity) {
				const span = lastBottom - firstTop;
				const progress = span > 0 ? Math.min(Math.max((readingLine - firstTop) / span, 0), 1) : 1;
				progressFill.style.height = `${progress * 100}%`;
			}
		};

		let ticking = false;
		const onScroll = () => {
			if (!ticking) {
				ticking = true;
				requestAnimationFrame(() => {
					ticking = false;
					update();
				});
			}
		};

		window.addEventListener("scroll", onScroll, { passive: true });
		window.addEventListener("resize", onScroll);
		update();
	}
</script>
