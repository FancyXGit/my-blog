---
import { musicTracks } from "@/data/music";

const audioList = musicTracks.map((track) => {
	return {
		name: track.title,
		artist: track.artist,
		url: track.audioUrl,
		cover: track.coverUrl,
		lrc: track.lyricsUrl || "",
		lyrics: track.lyrics || "",
	};
});
---

<div id="music-aplayer" class="mt-6"></div>
<script type="application/json" id="music-aplayer-data" set:html={JSON.stringify(audioList)}></script>

<link rel="stylesheet" href="https://unpkg.com/aplayer@1.10.1/dist/APlayer.min.css" />
<script src="https://unpkg.com/aplayer@1.10.1/dist/APlayer.min.js" defer></script>

<style is:inline>
	:root[data-theme="dark"] .aplayer {
		--aplayer-card-bg: hsl(var(--bg-hue) var(--bg-saturation) calc(var(--bg-brightness) + 3%));
		--aplayer-border: var(--theme-color-250);
		background: var(--aplayer-card-bg);
		color: var(--theme-color-800);
		box-shadow: 0 2px 8px rgba(0, 0, 0, 0.35);
	}

	:root[data-theme="dark"] .aplayer.aplayer-withlist .aplayer-info,
	:root[data-theme="dark"] .aplayer.aplayer-fixed .aplayer-list,
	:root[data-theme="dark"] .aplayer.aplayer-fixed .aplayer-info,
	:root[data-theme="dark"] .aplayer .aplayer-list ol li {
		border-color: var(--aplayer-border);
	}

	:root[data-theme="dark"] .aplayer.aplayer-fixed .aplayer-body {
		background: var(--aplayer-card-bg);
	}

	:root[data-theme="dark"] .aplayer.aplayer-fixed .aplayer-lrc {
		text-shadow: -1px -1px 0 hsl(var(--theme-bg));
	}

	:root[data-theme="dark"] .aplayer .aplayer-info .aplayer-music .aplayer-author,
	:root[data-theme="dark"] .aplayer .aplayer-info .aplayer-controller .aplayer-time,
	:root[data-theme="dark"] .aplayer .aplayer-list ol li .aplayer-list-index,
	:root[data-theme="dark"] .aplayer .aplayer-list ol li .aplayer-list-author,
	:root[data-theme="dark"] .aplayer .aplayer-lrc p {
		color: var(--theme-color-500);
	}

	:root[data-theme="dark"] .aplayer .aplayer-info .aplayer-controller .aplayer-bar-wrap .aplayer-bar {
		background: var(--theme-color-250);
	}

	:root[data-theme="dark"] .aplayer .aplayer-info .aplayer-controller .aplayer-bar-wrap .aplayer-bar .aplayer-loaded,
	:root[data-theme="dark"] .aplayer .aplayer-info .aplayer-controller .aplayer-volume-wrap .aplayer-volume-bar-wrap .aplayer-volume-bar {
		background: var(--theme-color-450);
	}

	:root[data-theme="dark"] .aplayer .aplayer-info .aplayer-controller .aplayer-time .aplayer-icon path,
	:root[data-theme="dark"] .aplayer .aplayer-miniswitcher .aplayer-icon path {
		fill: var(--theme-color-500);
	}

	:root[data-theme="dark"] .aplayer .aplayer-info .aplayer-controller .aplayer-time .aplayer-icon:hover path,
	:root[data-theme="dark"] .aplayer .aplayer-miniswitcher .aplayer-icon:hover path {
		fill: var(--theme-color-900);
	}

	:root[data-theme="dark"] .aplayer .aplayer-list ol li:hover {
		background: var(--theme-color-150);
	}

	:root[data-theme="dark"] .aplayer .aplayer-list ol li.aplayer-list-light {
		background: var(--theme-color-200);
	}

	:root[data-theme="dark"] .aplayer .aplayer-list ol::-webkit-scrollbar-thumb {
		background-color: var(--theme-color-250);
	}

	:root[data-theme="dark"] .aplayer .aplayer-list ol::-webkit-scrollbar-thumb:hover {
		background-color: var(--theme-color-400);
	}

	:root[data-theme="dark"] .aplayer .aplayer-miniswitcher {
		background: var(--theme-color-200);
	}

	:root[data-theme="dark"] .aplayer .aplayer-lrc:before {
		background: linear-gradient(180deg, var(--aplayer-card-bg) 0, hsl(var(--theme-bg) / 0) 100%);
	}

	:root[data-theme="dark"] .aplayer .aplayer-lrc:after {
		background: linear-gradient(180deg, hsl(var(--theme-bg) / 0) 0, var(--aplayer-card-bg) 100%);
	}

	:root[data-theme="dark"] .aplayer .aplayer-notice {
		background: hsl(var(--bg-hue) var(--bg-saturation) 24%);
		color: hsl(var(--fg-hue) var(--fg-saturation) 88%);
	}
</style>

<script is:inline>
	(() => {
		const EMPTY_LRC_URL = "/music/lyrics/empty.lrc";
		const LYRIC_FETCH_TIMEOUT_MS = 1800;
		let cachedEmptyLrc = "[00:00.00] ";

		const loadEmptyLrc = async () => {
			if (cachedEmptyLrc && cachedEmptyLrc.trim().length > 0) return cachedEmptyLrc;
			try {
				const response = await fetch(EMPTY_LRC_URL, { credentials: "same-origin" });
				if (response.ok) {
					cachedEmptyLrc = await response.text();
				}
			} catch {
				cachedEmptyLrc = "[00:00.00] ";
			}
			return cachedEmptyLrc;
		};

		const loadLyricText = async (url) => {
			const controller = new AbortController();
			const timeoutId = window.setTimeout(() => controller.abort(), LYRIC_FETCH_TIMEOUT_MS);

			try {
				const response = await fetch(url, {
					mode: "cors",
					credentials: "omit",
					signal: controller.signal,
				});
				if (!response.ok) {
					console.warn(`[APlayer] lyric request failed: status ${response.status} (${url})`);
					return "";
				}
				return await response.text();
			} catch (error) {
				console.warn(`[APlayer] lyric request failed: ${url}`, error);
				return "";
			} finally {
				window.clearTimeout(timeoutId);
			}
		};

		const loadLyrics = async (list) => {
			const emptyLrc = await loadEmptyLrc();
			const rows = await Promise.all(
				list.map(async (item) => {
					let lrcText = "";

					if (item.lrc) {
						lrcText = await loadLyricText(item.lrc);
					}

					if (!lrcText && item.lyrics) {
						lrcText = item.lyrics;
					}

					if (!lrcText) {
						lrcText = emptyLrc;
					}

					return { ...item, lrc: lrcText };
				}),
			);

			return rows;
		};

		const bindPreciseSeek = (aplayer, container) => {
			const barWrap = container.querySelector(".aplayer-bar-wrap");
			if (!barWrap || !aplayer || !aplayer.audio) return;

			const seekFromPointer = (clientX) => {
				const duration = Number(aplayer.audio.duration || 0);
				if (!Number.isFinite(duration) || duration <= 0) return;
				const rect = barWrap.getBoundingClientRect();
				if (!rect.width) return;
				const ratio = Math.max(0, Math.min(1, (clientX - rect.left) / rect.width));
				aplayer.audio.currentTime = duration * ratio;
				if (aplayer.bar && typeof aplayer.bar.set === "function") {
					aplayer.bar.set("played", ratio, "width");
				}
			};

			barWrap.addEventListener(
				"pointerdown",
				(event) => {
					event.preventDefault();
					event.stopImmediatePropagation();
					seekFromPointer(event.clientX);
				},
				true,
			);
		};

		const init = () => {
			const container = document.getElementById("music-aplayer");
			const dataNode = document.getElementById("music-aplayer-data");
			if (!container || !dataNode || typeof window.APlayer === "undefined") return;

			if (container.dataset.aplayerInitialized === "true") return;
			container.dataset.aplayerInitialized = "true";

			let list = [];
			try {
				list = JSON.parse(dataNode.textContent || "[]");
			} catch {
				list = [];
			}

			if (!Array.isArray(list) || list.length === 0) return;

			loadLyrics(list).then((audioWithLyrics) => {
				const player = new window.APlayer({
					container,
					audio: audioWithLyrics,
					lrcType: 1,
					fixed: false,
					mini: false,
					autoplay: false,
					loop: "all",
					order: "list",
					preload: "auto",
					volume: 0.65,
					mutex: true,
					theme: "#2bbc8a",
				});

				bindPreciseSeek(player, container);
			});
		};

		if (document.readyState === "loading") {
			document.addEventListener("DOMContentLoaded", init, { once: true });
		} else {
			init();
		}
	})();
</script>
