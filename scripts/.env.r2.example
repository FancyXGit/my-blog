# Copy this file to project root as .env.r2, then fill in your values.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=https://img.example.com

# Optional
R2_REGION=auto
R2_PREFIX=
R2_CACHE_CONTROL=public, max-age=604800
WEBP_QUALITY=82
WEBP_EFFORT=5

# CN asset host (optional; enables the SFTP mirror upload)
# CN_ASSET_SSH_ALIAS=new
# CN_ASSET_HOST=
# CN_ASSET_PORT=22
# CN_ASSET_USER=
# CN_ASSET_KEY_PATH=
# CN_ASSET_ROOT=/var/www/cdn-fancyflow.cn
# CN_PUBLIC_BASE_URL=https://cdn.fancyflow.cn
